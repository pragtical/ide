{
  "addons": [
    {
      "id": "build",
      "version": "0.3.1",
      "mod_version": "3.12.3",
      "description": "Build targets, compiler diagnostics and program output. Supports Make, CMake, Meson, Gradle, shell scripts and an internal C/C++ backend. *([screenshot](https://raw.githubusercontent.com/pragtical/ide/master/screenshots/build.png))*",
      "path": "plugins/build",
      "dependencies": {}
    },
    {
      "id": "debugger",
      "version": "0.3.1",
      "mod_version": "3.12.3",
      "description": "Debugger integration with GDB MI and DAP backends, source breakpoints, stack navigation and watch expressions. *([screenshot](https://raw.githubusercontent.com/pragtical/ide/master/screenshots/debugger.png))*",
      "path": "plugins/debugger",
      "dependencies": {
        "build": {},
        "terminal": {
          "optional": true
        }
      }
    },
    {
      "id": "ide",
      "version": "0.3.1",
      "description": "A metapackage that provides the minimum functionalities for Pragtical to run as a minimal IDE.",
      "mod_version": "3.12.3",
      "path": "plugins/ide.lua",
      "dependencies": {
        "meta_colors": {},
        "meta_languages": {},
        "align_carets": {
          "optional": true
        },
        "autoinsert": {},
        "autosave": {},
        "bracketmatch": {},
        "colorpreview": {},
        "extend_selection_line": {},
        "indentguide": {},
        "lfautoinsert": {},
        "lintplus": {},
        "lsp": {},
        "lsp_snippets": {},
        "minimap": {},
        "opacity": {
          "optional": true
        },
        "rainbowparen": {
          "optional": true
        },
        "scalestatus": {
          "optional": true
        },
        "selectionhighlight": {},
        "snippets": {},
        "sticky_scroll": {
          "optional": true
        },
        "todotreeview": {
          "optional": true
        },
        "scm": {},
        "terminal": {}
      }
    },
